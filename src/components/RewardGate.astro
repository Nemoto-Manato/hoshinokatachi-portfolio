---
// 広告部分。中身（slot）はSEOとAdSense審査のためHTMLに出力しておき、表示だけを切り替える。
// 広告を見る前は、各項目（恋愛・仕事・人間関係・相性・伸びしろ）の冒頭だけを読めるようにし、続きはぼかす。
// どの項目のボタンからでも、広告を1回見ればすべて読める（収入を増やすため、続きが気になった場所ですぐ押せるようにする）。
// ボタンを押すと showRewardedAd()（lib/reward-ad.ts）を呼び、true なら中身を表示して、押した項目までスクロールする。
import { makeTeaser } from '../lib/teaser';

interface Props {
  /** チラ見せする項目。順番は slot の中の見出し（h2）と同じにする */
  items: { title: string; text: string }[];
}

const { items } = Astro.props;
const teasers = items.map((item) => ({ title: item.title, ...makeTeaser(item.text) }));
---

<div class="reward-gate" data-reward-gate>
  <div data-reward-cover>
    {teasers.map((t, i) => (
      <section class="card teaser">
        <h2>{t.title}</h2>
        <p class="teaser-text">
          {t.visible}<span class="blurred" aria-hidden="true">{t.blurred}</span>
        </p>
        <div class="cta">
          {i === 0 && <p class="cta-lead">広告を1回見ると、恋愛・仕事・人間関係・相性TOP3・伸びしろが<br />すべて全文で読めます</p>}
          <button class="button" type="button" data-reward-button data-index={i}>広告を見て全部読む</button>
        </div>
      </section>
    ))}
    <p class="muted error" data-reward-error role="alert" hidden>広告を読み込めませんでした。時間をおいて、もう一度お試しください。</p>
  </div>
  <div data-reward-content hidden>
    <slot />
  </div>
</div>

<script>
  import { showRewardedAd } from '../lib/reward-ad';

  for (const gate of document.querySelectorAll<HTMLElement>('[data-reward-gate]')) {
    const buttons = [...gate.querySelectorAll<HTMLButtonElement>('[data-reward-button]')];
    const cover = gate.querySelector<HTMLElement>('[data-reward-cover]')!;
    const content = gate.querySelector<HTMLElement>('[data-reward-content]')!;
    const error = gate.querySelector<HTMLElement>('[data-reward-error]')!;

    for (const button of buttons) {
      button.addEventListener('click', async () => {
        for (const b of buttons) b.disabled = true;
        error.hidden = true;
        let rewarded = false;
        try {
          rewarded = await showRewardedAd();
        } catch {
          rewarded = false;
        }
        if (rewarded) {
          cover.hidden = true;
          content.hidden = false;
          // 押した項目と同じ見出しまでスクロールする。
          const index = Number(button.dataset.index ?? 0);
          content.querySelectorAll('h2')[index]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          // エラーは押したボタンのすぐ下に出す。
          button.after(error);
          error.hidden = false;
          for (const b of buttons) b.disabled = false;
        }
      });
    }
  }
</script>

<style>
  .teaser { margin-top: 16px; position: relative; overflow: hidden; }
  .teaser h2 { margin-top: 0; }
  .teaser-text { margin-bottom: 0; }
  /* 続きは読めない程度にぼかす（選択・コピーもできないようにする） */
  .blurred { filter: blur(5px); user-select: none; pointer-events: none; }
  /* ぼかした本文の下半分に、夜空色のグラデーションをかぶせてボタンを重ねる */
  .cta {
    position: relative;
    margin: -72px -16px -16px;
    padding: 80px 16px 20px;
    text-align: center;
    background: linear-gradient(180deg, transparent 0%, var(--night) 55%);
  }
  .cta-lead { margin: 0 0 12px; font-size: 0.9rem; font-weight: 600; }
  .cta .button:disabled { opacity: 0.6; cursor: wait; }
  .error { text-align: center; margin: 8px 0 0; }
</style>
